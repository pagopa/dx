{
  "name": "@pagopa/skill-evals",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable deterministic and model-graded evaluation runner for Agent Skills.",
  "type": "module",
  "bin": {
    "skill-evals": "./dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown src/cli.ts --format esm",
    "eval": "node ./dist/cli.mjs eval",
    "scaffold": "node ./dist/cli.mjs scaffold",
    "test": "vitest run",
    "validate": "node ./dist/cli.mjs validate"
  },
  "devDependencies": {
    "@pagopa/eslint-config": "workspace:^",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "commander": "catalog:",
    "tslib": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default"
        ],
        "outputs": [
          "{projectRoot}/dist/**"
        ]
      },
      "eval": {
        "cache": false,
        "dependsOn": [
          "build"
        ]
      },
      "scaffold": {
        "cache": false,
        "dependsOn": [
          "build"
        ]
      },
      "validate": {
        "cache": false,
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
