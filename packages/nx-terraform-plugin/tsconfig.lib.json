{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // @nx/js:tsc may compile from a generated tsconfig under the workspace
    // tmp/ folder, so @types must be resolved relative to this file.
    "emitDeclarationOnly": false,
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./src/**/*.test.ts", "./src/**/*.spec.ts"]
}
