{
  "name": "@pagopa/nx-terraform",
  "version": "0.5.15",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pagopa/dx.git",
    "directory": "packages/nx-terraform-plugin"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./release/version-actions": {
      "types": "./dist/release/version-actions.d.ts",
      "import": "./dist/release/version-actions.js",
      "default": "./dist/release/version-actions.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "generate": "node src/generate-module-schema.ts"
  },
  "dependencies": {
    "@logtape/logtape": "catalog:",
    "@nx/devkit": "catalog:",
    "@octokit/auth-app": "catalog:",
    "execa": "catalog:",
    "octokit": "catalog:",
    "semver": "catalog:",
    "tslib": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pagopa/dx-tasks": "workspace:^",
    "@pagopa/eslint-config": "workspace:^",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "executors": "./executors.json",
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "cache": true,
        "dependsOn": [
          "^build"
        ],
        "options": {
          "outputPath": "packages/nx-terraform-plugin/dist",
          "main": "packages/nx-terraform-plugin/src/index.ts",
          "rootDir": "packages/nx-terraform-plugin/src",
          "tsConfig": "packages/nx-terraform-plugin/tsconfig.lib.json",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "packages/nx-terraform-plugin/src/generators",
              "glob": "**/schema.json",
              "output": "generators"
            },
            {
              "input": "packages/nx-terraform-plugin/src/generators",
              "glob": "**/files/**",
              "output": "generators"
            }
          ]
        }
      }
    }
  }
}
