# Generated by harbor-mod. Base image must be glibc (Copilot CLI is a Node SEA
# for glibc; musl/Alpine fails). Default ubuntu:24.04; override via the `harbor`
# block in evals.json (base_image).
FROM {base_image}

ARG TARGETARCH=amd64

RUN apt-get update && apt-get install -y --no-install-recommends \
    git bash curl ca-certificates unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Deterministic fixture repository (git baseline so the agent can diff).
COPY . /workspace/

# Optional build-time setup: a skill can ship a prepare.sh (skill-level
# `harbor.prepare_script`, overridable per eval) to install extra tooling or
# seed the workspace before the agent runs. Runs before the git baseline so
# prepared files are part of the agent's starting repo.
RUN if [ -f /workspace/prepare.sh ]; then \
        bash /workspace/prepare.sh; \
    fi

# Deterministic repo-local identity for the baseline commit (never touches the
# base image's global config). `--allow-empty` keeps the baseline commit valid
# for empty workspaces (no files to stage), where `git commit` would otherwise
# exit 1. No `|| true`: any other failure (e.g. broken git) still fails the
# build visibly, so every generated environment starts with a valid baseline
# and a clean worktree.
RUN git init -q \
    && git config user.name "harbor-mod" \
    && git config user.email "harbor-mod@pagopa.invalid" \
    && git add -A \
    && git commit -qm baseline --allow-empty

WORKDIR /workspace
