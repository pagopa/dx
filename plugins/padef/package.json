{
  "name": "@pagopa/padef",
  "private": true,
  "description": "PagoPA Agentic Delivery Framework plugin, plus the runtime helpers its skills ship",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "test": "node --test src/render-mermaid.test.ts"
  },
  "dependencies": {
    "pele": "1.13.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/skills/confluence-librarian/scripts/render-mermaid.mjs"
        ]
      },
      "test": {
        "dependsOn": [
          "build"
        ]
      },
      "lint": {
        "command": "oxlint --config ../../.oxlintrc.json src tsdown.config.ts",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "typecheck": {
        "command": "tsc --noEmit -p tsconfig.json",
        "options": {
          "cwd": "{projectRoot}"
        }
      },
      "build:check": {
        "command": "pnpm run build && git diff --exit-code -- skills/confluence-librarian/scripts/render-mermaid.mjs",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  }
}
