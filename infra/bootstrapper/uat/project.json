{
  "name": "bootstrapper-uat",
  "targets": {
    "test-init": {
      "cache": false,
      "configurations": {
        "ci": {
          "frozenLockfile": true
        }
      },
      "executor": "@pagopa/nx-terraform:init",
      "options": {
        "args": ["-backend=false", "-input=false"],
        "platforms": ["linux_amd64"],
        "projectRoot": "{projectRoot}/tests/terraform"
      },
      "outputs": [
        "{projectRoot}/tests/terraform/.terraform",
        "{projectRoot}/tests/terraform/.terraform.lock.hcl",
        "{projectRoot}/tests/terraform/tfmodules.lock.json"
      ]
    },
    "test": {
      "cache": false,
      "command": "terraform test -test-directory=.",
      "dependsOn": ["test-init"],
      "options": {
        "cwd": "{projectRoot}/tests/terraform"
      }
    }
  }
}
