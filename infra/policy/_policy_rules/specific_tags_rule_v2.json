{
  "if": {
    "anyOf": [
      {
        "allOf": [
          {
            "field": "tags['CostCenter']",
            "exists": true
          },
          {
            "field": "tags['CostCenter']",
            "notMatch": "TS000 - TECNOLOGIA & SERVIZI"
          }
        ]
      },
      {
        "allOf": [
          {
            "field": "tags['Owner']",
            "exists": true
          },
          {
            "field": "tags['Owner']",
            "notMatch": "DevEx"
          }
        ]
      },
      {
        "allOf": [
          {
            "field": "tags['Environment']",
            "exists": true
          },
          {
            "field": "tags['Environment']",
            "notMatch": "Dev"
          },
          {
            "field": "tags['Environment']",
            "notMatch": "Uat"
          },
          {
            "field": "tags['Environment']",
            "notMatch": "Prod"
          }
        ]
      },
      {
        "allOf": [
          {
            "field": "tags['Source']",
            "exists": true
          },
          {
            "anyOf": [
              {
                "field": "tags['Source']",
                "notLike": "https://github.com/pagopa/dx/blob/main/infra/*"
              },
              {
                "field": "tags['Source']",
                "equals": "https://github.com/pagopa/dx/blob/main/infra/"
              }
            ]
          }
        ]
      },
      {
        "allOf": [
          {
            "field": "tags['CostCenter']",
            "exists": true
          },
          {
            "value": "[contains(string(field('tags')), '\"CostCenter\":')]",
            "equals": false
          }
        ]
      },
      {
        "allOf": [
          {
            "field": "tags['Owner']",
            "exists": true
          },
          {
            "value": "[contains(string(field('tags')), '\"Owner\":')]",
            "equals": false
          }
        ]
      },
      {
        "allOf": [
          {
            "field": "tags['Environment']",
            "exists": true
          },
          {
            "value": "[contains(string(field('tags')), '\"Environment\":')]",
            "equals": false
          }
        ]
      },
      {
        "allOf": [
          {
            "field": "tags['Source']",
            "exists": true
          },
          {
            "value": "[contains(string(field('tags')), '\"Source\":')]",
            "equals": false
          }
        ]
      }
    ]
  },
  "then": {
    "effect": "deny"
  }
}
