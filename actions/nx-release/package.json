{
  "name": "nx-release",
  "version": "0.3.12",
  "private": true,
  "description": "Action to automate releases of npm packages in an Nx monorepo. It creates a PR with the version changes and changelog updates, and when the PR is merged, it creates git tags and publishes the packages to npm.",
  "keywords": [
    "action",
    "github",
    "nx",
    "pr",
    "release"
  ],
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@octokit/rest": "catalog:",
    "js-yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@pagopa/eslint-config": "workspace:^",
    "@tsconfig/node24": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
