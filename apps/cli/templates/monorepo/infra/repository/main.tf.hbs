module "github_repository" {
  source  = "pagopa-dx/github-environment-bootstrap/github"
  version = "~> 3.0"

  repository = {
    name                   = "{{ repoName }}"
    description            = "{{ repoDescription }}"
    topics                 = [{{#each repoTopics}}"{{this}}"{{#unless @last}}, {{/unless}}{{/each}}]
    reviewers_teams        = []
  }
}
