{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Group major updates for PagoPA DX Terraform modules.",
  "packageRules": [
    {
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-module"],
      "matchPackageNames": ["/^pagopa-dx\\//"],
      "matchUpdateTypes": ["major"],
      "groupName": "PagoPA DX Terraform modules versions"
    }
  ]
}
